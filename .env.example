# ─── Required ───────────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Required (Phase 2) ─────────────────────────
# Get your free key at: https://app.tavily.com/home
TAVILY_API_KEY=your_tavily_api_key_here

# ─── Required (Phase 2.6 — Devil's Advocate Mode) ─
# Get your free token at: https://apify.com/sign-up
# Used to run the trudax/reddit-scraper Actor on Apify.
APIFY_API_TOKEN=your_apify_api_token_here

# ─── Optional: LangSmith Observability ──────────
# Free tier at: https://smith.langchain.com/
# Leave these commented out to disable tracing.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=product-recommendation-agent
